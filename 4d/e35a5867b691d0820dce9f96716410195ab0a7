9512-90665e51d828","sessionKind":"bg","session_id":"eb608668-7a33-49bd-9512-90665e51d828","sourceToolAssistantUUID":"956e41f5-b079-40fe-8764-bbc64ab9a659","timestamp":"2026-08-12T01:37:52.169Z","toolUseResult":{"file":{"content":"\"\"\"Component 5 (download) — fetch PDFs for the papers I kept in review.\n\nReads the review feedback log (``state/feedback.jsonl``), takes the **latest**\ndecision per arXiv ID (via :func:`recsys.feedback.kept_papers`), and downloads a\nPDF for every *kept* paper into ``pdfs-to-summarize/`` — the folder the existing\n``newsletter-podcast.py`` summarizer already consumes. This is deliberately a\n**separate step you run after filtering**, not part of review, so triage stays\nfast and offline and you only pull PDFs once you're done.\n\nIdempotent: a paper whose destination PDF already exists is skipped, so you can\nre-run it as you work through a big backlog across sessions. Filenames mirror the\nlegacy convention (``{title-with-illegal-chars-stripped}.pdf``) so the summarizer\nand your Obsidian ``![[...]]`` embeds line up with the old ``pdfs/`` flow.\n\nUsage::\n\n    python -m recsys.review              # triage -> records keeps to state/feedback.jsonl\n    python -m recsys.download            # fetch PDFs for everything kept (skip existing)\n    python -m recsys.download --dry-run  # list what *would* download; fetch nothing\n    python -m recsys.download --dest pdfs # download somewhere else\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport re\nimport time\nfrom pathlib import Path\n\nimport requests\n\nfrom recsys import feedback\n\nREPO_ROOT = Path(__file__).resolve().parent.parent\nDEST_DIR = REPO_ROOT / \"pdfs-to-summarize\"\n\n# arXiv asks for a descriptive UA; a bare requests default gets throttled harder.\n_UA = \"arxiv-recsys/1.0 (mailto:evintunador@gmail.com)\"\n\n\ndef safe_title(title: str) -> str:\n    \"\"\"Filesystem-safe filename stem, matching the legacy downloader's scheme.\n\n    Mirrors ``arxiv-link-downloader.py`` (``[<>:\"/\\\\|?*]`` -> ``' -'``) so a paper\n    kept here collides with (and is skipped against) one grabbed the old way.\n    \"\"\"\n    return re.sub(r'[<>:\"/\\\\|?*]', \" -\", title).strip()\n\n\ndef pdf_url(arxiv_id: str) -> str:\n    \"\"\"Canonical PDF URL for a (version-stripped) arXiv ID; serves the latest version.\"\"\"\n    return f\"https://arxiv.org/pdf/{arxiv_id}.pdf\"\n\n\ndef _download(url: str, dest: Path, *, timeout: float) -> None:\n    \"\"\"Stream a PDF to ``dest`` atomically (write to ``.part``, then rename).\"\"\"\n    resp = requests.get(url, headers={\"User-Agent\": _UA}, timeout=timeout, stream=True)\n    resp.raise_for_status()\n    ctype = resp.headers.get(\"Content-Type\", \"\")\n    if \"pdf\" not in ctype.lower():\n        raise RuntimeError(f\"not a PDF (Content-Type: {ctype or 'unknown'})\")\n    tmp = dest.with_suffix(dest.suffix + \".part\")\n    with tmp.open(\"wb\") as f:\n        for chunk in resp.iter_content(chunk_size=1 << 15):\n            if chunk:\n                f.write(chunk)\n    tmp.replace(dest)\n\n\ndef run(*, dest_dir: Path = DEST_DIR, dry_run: bool = False, delay: float = 3.0,\n        timeout: float = 30.0, limit: int | None = None,\n        feedback_path=feedback.FEEDBACK_PATH) -> dict:\n    \"\"\"Download PDFs for every kept paper missing from ``dest_dir``.\n\n    Returns a summary dict: ``{kept, already, downloaded, failed:[(id,err)]}``.\n    \"\"\"\n    kept = feedback.kept_papers(feedback_path)\n    dest_dir.mkdir(parents=True, exist_ok=True)\n\n    pending = []\n    already = 0\n    for e in kept:\n        stem = safe_title(e.get(\"title\") or e[\"arxiv_id\"])\n        target = dest_dir / f\"{stem}.pdf\"\n        if target.exists():\n            already += 1\n            continue\n        pending.append((e, target))\n    if limit is not None:\n        pending = pending[:limit]\n\n    print(f\"kept: {len(kept)}  ·  already downloaded: {already}  ·  to fetch: {len(pending)}\"\n          f\"{'  (dry run)' if dry_run else ''}\")\n\n    downloaded = 0\n    failed: list[tuple[str, str]] = []\n    for i, (e, target) in enumerate(pending, 1):\n        aid = e[\"arxiv_id\"]\n        url = pdf_url(aid)\n        if dry_run:\n            print(f\"  [{i}/{len(pending)}] would fetch {aid} -> {target.name}\")\n            continue\n        try:\n            _download(url, target, timeout=timeout)\n            downloaded += 1\n            print(f\"  [{i}/{len(pending)}] {aid} -> {target.name}\")\n        except Exception as ex:  # network/HTTP/non-PDF — log and keep going\n            failed.append((aid, str(ex)))\n            print(f\"  [{i}/{len(pending)}] FAILED {aid}: {ex}\")\n        if i < len(pending):\n            time.sleep(delay)  # be polite to arXiv\n\n    if failed:\n        print(f\"\\n{len(failed)} failed:\")\n        for aid, err in failed:\n            print(f\"  {aid}: {err}\")\n    if not dry_run:\n        print(f\"\\ndone: {downloaded} downloaded into {dest_dir}\"\n              f\"{f', {len(failed)} failed' if failed else ''}.\")\n    return {\"kept\": len(kept), \"already\": already, \"downloaded\": downloaded, \"failed\": failed}\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser(description=\"Download PDFs for papers kept in review.\")\n    ap.add_argument(\"--dest\", type=Path, default=DEST_DIR,\n                    help=\"destination folder (default: pdfs-to-summarize/)\")\n    ap.add_argument(\"--dry-run\", action=\"store_true\", help=\"list what would download; fetch nothing\")\n    ap.add_argument(\"--delay\", type=float, default=3.0, help=\"politeness delay between downloads (s)\")\n    ap.add_argument(\"--timeout\", type=float, default=30.0, help=\"per-request timeout (s)\")\n    ap.add_argument(\"--limit\", type=int, default=None, help=\"cap the number of downloads this run\")\n    args = ap.parse_args()\n    run(dest_dir=args.dest, dry_run=args.dry_run, delay=args.delay,\n        timeout=args.timeout, limit=args.limit)\