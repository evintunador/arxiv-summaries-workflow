ading\n# --------------------------------------------------------------------------- #\n\ndef latest_candidates_csv(digests_dir: Path = DIGESTS_DIR) -> Path | None:\n    files = sorted(digests_dir.glob(\"candidates_*.csv\"))\n    return files[-1] if files else None\n\n\ndef _to_float(s: str) -> float | None:\n    return float(s) if s not in (\"\", None) else None\n\n\ndef load_candidates(path: str | Path) -> list[dict]:\n    \"\"\"Load a candidates CSV into ranked dict rows (scores parsed; '' -> None).\"\"\"\n    rows = []\n    with Path(path).open(\"r\", encoding=\"utf-8\", newline=\"\") as f:\n        for r in csv.DictReader(f):\n            rows.append({\n                \"rank\": int(r[\"rank\"]),\n                \"arxiv_id\": r[\"arxiv_id\"],\n                \"title\": r[\"title\"],\n                \"link\": r[\"link\"],\n                \"paper_date\": r.get(\"paper_date\", \"\"),\n                \"stage1_score\": _to_float(r[\"stage1_score\"]),\n                \"stage2_score\": _to_float(r[\"stage2_score\"]),\n                \"abstract\": r.get(\"abstract\", \"\"),\n            })\n    rows.sort(key=lambda r: r[\"rank\"])\n    return rows\n\n\n# --------------------------------------------------------------------------- #\n# Review session core (pending queue + decision recording)\n# --------------------------------------------------------------------------- #\n\nclass ReviewSession:\n    \"\"\"Holds the pending queue and records decisions to the feedback log.\"\"\"\n\n    def __init__(self, candidates: list[dict], *, run_date: str = \"\",\n                 skip_reviewed: bool = True, feedback_path=feedback.FEEDBACK_PATH):\n        self.run_date = run_date\n        self.feedback_path = feedback_path\n        already = feedback.reviewed_ids(feedback_path) if skip_reviewed else set()\n        self.already_reviewed = len(already)\n        self.queue = [c for c in candidates if c[\"arxiv_id\"] not in already]\n        self.kept = 0\n        self.skipped = 0\n\n    def record(self, cand: dict, decision: str, abstract_viewed: bool) -> dict:\n        rec = feedback.record_event(\n            arxiv_id=cand[\"arxiv_id\"], decision=decision, abstract_viewed=abstract_viewed,\n            title=cand[\"title\"], link=cand[\"link\"], rank=cand.get(\"rank\"),\n            stage1_score=cand.get(\"stage1_score\"), stage2_score=cand.get(\"stage2_score\"),\n            run_date=self.run_date, path=self.feedback_path,\n        )\n        if decision == \"keep\":\n            self.kept += 1\n        else:\n            self.skipped += 1\n        return rec\n\n\n# --------------------------------------------------------------------------- #\n# Terminal frontend\n# --------------------------------------------------------------------------- #\n\ndef _fmt_scores(c: dict) -> str:\n    s1 = \"—\" if c[\"stage1_score\"] is None else f\"{c['stage1_score']:.3f}\"\n    s2 = \"—\" if c[\"stage2_score\"] is None else f\"{c['stage2_score']:.3f}\"\n    return f\"s1={s1} s2={s2}\"\n\n\ndef _prompt(msg: str) -> str:\n    try:\n        return input(msg).strip().lower()\n    except EOFError:\n        return \"q\"\n\n\ndef _batch_stats(batch_keeps: list[int]) -> dict:\n    \"\"\"Trend stats for the between-batch prompt (pure -> unit-testable).\n\n    Because the queue is ranked best-first, keeps-per-batch should decay as you go\n    deeper. ``tailing_off`` flags the inflection: the recent keep rate has dropped\n    well below its peak, so you're likely into diminishing returns. Smoothed over\n    the last two batches so one fluky batch doesn't trip (or suppress) it.\n    \"\"\"\n    this = batch_keeps[-1]\n    prev = batch_keeps[-2] if len(batch_keeps) >= 2 else None\n    peak = max(batch_keeps)\n    pct_of_peak = round(100 * this / peak) if peak else 0\n    recent = batch_keeps[-2:]\n    recent_avg = sum(recent) / len(recent)\n    # require a real peak (>=3) so tiny, noisy counts don't trigger a stop suggestion.\n    tailing_off = len(batch_keeps) >= 2 and peak >= 3 and recent_avg <= 0.4 * peak\n    return {\"this\": this, \"prev\": prev, \"peak\": peak,\n            \"pct_of_peak\": pct_of_peak, \"tailing_off\": tailing_off}\n\n\ndef _batch_report(batch_keeps: list[int], batch: int, kept: int, done: int) -> str:\n    \"\"\"Format the between-batch trend line(s): this batch, trajectory, tail-off hint.\"\"\"\n    st = _batch_stats(batch_keeps)\n    rate = round(100 * st[\"this\"] / batch) if batch else 0\n    orate = round(100 * kept / done) if done else 0\n    if st[\"prev\"] is None:\n        arrow = \"\"\n    elif st[\"this\"] > st[\"prev\"]:\n        arrow = f\"  ↑ from {st['prev']}\"\n    elif st[\"this\"] < st[\"prev\"]:\n        arrow = f\"  ↓ from {st['prev']}\"\n    else:\n        arrow = \"  → same as last\"\n    traj = \" \".join(str(b) for b in batch_keeps)\n    lines = [\n        f\"\\n— batch {len(batch_keeps)}: kept {st['this']}/{batch} ({rate}%){arrow}\"\n        f\"   ·   overall {kept}/{done} ({orate}%)\",\n        f\"  keeps/batch: {traj}   (peak {st['peak']}, now {st['pct_of_peak']}% of peak)\",\n    ]\n    if st[\"tailing_off\"]:\n        lines.append(\"  ▼ keep rate has fallen well below its peak — likely diminishing \"\n                     \"returns; a natural place to stop.\")\n    return \"\\n\".join(lines)\n\n\ndef review_terminal(session: ReviewSession, *, batch: int) -> None:\n    total = len(session.queue)\n    if not total:\n        print(\"Nothing to review — the queue is empty \"\n              f\"({session.already_reviewed} already decided).\")\n        return\n    print(f\"\\n{total} papers to review ({session.already_reviewed} already decided). \"\n          f\"Batches of {batch}. Keys: [k]eep [s]kip [a]bstract [o]pen [q]uit\\n\")\n\n    import textwrap\n    import webbrowser\n\n    in_batch = 0\n    prev_kept = 0\n    batch_keeps: list[int] = []\n    for c in session.queue:\n        viewed = False\n        print(f\"\\n[rank {c['rank']}]  {_fmt_scores(c)}  {c['paper_date']}\")\n        print(textwrap.fill(c[\"title\"], width=88))\n        print(f\"  {c['link']}\")\n\n        decision = None\n        while decision is None:\n            choice = _prompt(\"  [k]eep [s]kip [a]bstract [o]pen [q]uit > \")\n            if choice in (\"k\", \"keep\"):\n                decision = \"keep\"\n            elif choice in (\"s\", \"skip\"):\n                decision = \"skip\"\n            elif choice in (\"a\", \"abstract\"):\n                viewed = True\n                print()\n                print(textwrap.fill(c[\"abstract\"] or \"(no abstract)\", width=88,\n                                    initial_indent=\"  \", subsequent_indent=\"  \"))\n            elif choice in (\"o\", \"open\"):\n                webbrowser.open(c[\"link\"])\n                print(f\"  opened {c['link']}\")\n            elif choice in (\"q\", \"quit\"):\n                print(\"\\nquitting.\")\n                _summary(session)\n                return\n            else:\n                print(\"  (k/s/a/o/q)\")\n\n        session.record(c, decision, viewed)\n        tag = \"KEPT\" if decision == \"keep\" else \"skip\"\n        stage = \" [s1-neg]\" if (decision == \"skip\" and not viewed) else (\n                \" [s1+, s2-]\" if (decision == \"skip\" and viewed) else\n                \" [s1+, s2+]\" if viewed else \" [s1+]\")\n        print(f\"  -> {tag}{stage}\")\n\n        in_batch += 1\n        if in_batch >= batch:\n            in_batch = 0\n            batch_keeps.append(session.kept - prev_kept)\n            prev_kept = session.kept\n            done = session.kept + session.skipped\n            print(_batch_report(batch_keeps, batch, session.kept, done))\n            ans = _prompt(\"  keep going? [Y/n] \")\n            if ans in (\"n\", \"no\", \"q\", \"quit\"):\n                break\n\n    _summary(session)\n\n\ndef _summary(session: ReviewSession) -> None:\n    print(f\"\\n=== session done: {session.kept} kept, {session.skipped} skipped \"\n          f\"({session.kept + session.skipped} total) ===\")\n    print(f\"feedback log: {session.feedback_path}\")\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser(description=\"Terminal paper-review interface.\")\n    ap.add_argument(\"--csv\", type=Path, default=None, help=\"candidates CSV (default: latest)\")\n    ap.add_argument(\"--batch\", type=int, default=25, help=\"papers per batch before the density check\")\n    ap.add_argument(\"--all\", action=\"store_true\", help=\"include already-decided papers\")\n    args = ap.parse_args()\n\n    csv_path = args.csv or latest_candidates_csv()\n    if not csv_path or not Path(csv_path).exists():\n        print(\"No candidates CSV found — run `python -m recsys.infer` first.\")\n        return\n    run_date = Path(csv_path).stem.replace(\"candidates_\", \"\")\n    print(f\"reviewing {csv_path}\")\n    candidates = load_candidates(csv_path)\n    session = ReviewSession(candidates, run_date=run_date, skip_reviewed=not args.all)\n    review_terminal(session, batch=args.batch)\n\n\nif __name__ == \"__main__\":\n    main()\n","filePath":"/Users/evintunador/repos/evintunador/arxiv-summaries-workflow/recsys/review.py","numLines":251,"startLine":1,"totalLines":251},"type":"text"},"type":"user","userType":"external","uuid":"da31938c-839f-4759-83aa-10e94a91db60","version":"2.1.228"},"format":"claude-code-jsonl/1"},"recorded_at":"2026-08-12T01:42:49.486Z","schema":"annals/v1","stream":{"id":"claude-code:eb608668-7a33-49bd-9512-90665e51d828","seq":66}}
{"content":{"blocks":[{"content":"=== candidates_2026-06-30 row count ===\n  109596 data/digests/candidates_2026-06-30.csv\n=== candidates_2026-06-29 row count ===\n   28296 data/digests/candidates_2026-06-29.csv\n=== digest_2026-06-26.csv row count (odd name) ===\n      31 data/digests/digest_2026-06-26.csv\nrank,arxiv_id,title,link,paper_date,stage1_score,stage2_score,abstract\r\n1,2606.26493,Nemotron-TwoTower: Diffusion Language Modeling with Pretrained Autoregressive Context,https://arxiv.org/abs/2606.26493,2026-06-25,0.8982,0.9793,\"Diffusion language models offer a promising alternative to autoregressive models due to their potential for parallel and iterative generation. However, existing approaches use a single network for both context representation and iterative denoising, forcing one model to serve both roles and limiting its capacity for either role. We propose TwoTower, a block-wise autoregressive diffusion model that decouples these roles into two towers: a frozen AR context tower that causally processes clean tokens, and a trainable diffusion denoiser tower with bidirectional block attention that refines noisy blocks via cross-attention to the context. Built on Nemotron-3-Nano-30B-A3B, an open-weight 30B hybrid Mamba-Transformer MoE model, and trained on approximately 2.1T tokens, Nemotron-TwoTower retains 98.7% of the autoregressive baseline's quality while offering 2.42X higher wall-clock generation throughput. We release the code and model weights at https://huggingface.co/collections/nvidia/nemotron-twotower.\"\r\n2,2606.24504,On the Smallness of the Large Language Models Scaling Exponents,https://arxiv.org/abs/2606.24504,2026-06-23,0.9322,0.9720,\"We discuss reasons why the scaling exponents of current Large Language Models (LLMs) applications are indicating an unsustainable regime in terms of energy resources. We further show that attributing the smallness of such exponents to a numerical bias due to the neglect of a non-zero value of the loss f