{"content":{"blocks":[{"content":"1\t\"\"\"Component 5 (review) — terminal interface + shared review core.\n2\t\n3\tReads the ranked candidate pool written by :mod:`recsys.infer`\n4\t(``data/digests/candidates_<date>.csv``) and walks it newest-best-first,\n5\trecording **expand-to-distinguish** decisions (see :mod:`recsys.feedback`):\n6\t\n7\t    [k]eep  [s]kip  [a]bstract (reveal + mark title-interesting)  [o]pen url  [q]uit\n8\t\n9\tSkipping before opening the abstract is a stage-1 negative; opening it first\n10\tturns the decision into a stage-2 label too. The session resumes where you left\n11\toff (already-decided IDs are skipped) and processes in batches so you can stop\n12\twhen the density of interesting papers trails off.\n13\t\n14\tDecisions go only to ``state/feedback.jsonl`` (never the ground-truth CSVs); run\n15\t``python -m recsys.download`` afterward to pull PDFs for everything you kept.\n16\t\n17\tTerminal usage::\n18\t\n19\t    python -m recsys.review                 # latest candidates file, batches of 25\n20\t    python -m recsys.review --batch 50 --csv data/digests/candidates_2026-06-27.csv\n21\t\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\timport argparse\n26\timport csv\n27\timport datetime as dt\n28\tfrom pathlib import Path\n29\t\n30\tfrom recsys import feedback\n31\t\n32\tREPO_ROOT = Path(__file__).resolve().parent.parent\n33\tDIGESTS_DIR = REPO_ROOT / \"data\" / \"digests\"\n34\t\n35\t\n36\t# --------------------------------------------------------------------------- #\n37\t# Loading\n38\t# --------------------------------------------------------------------------- #\n39\t\n40\tdef latest_candidates_csv(digests_dir: Path = DIGESTS_DIR) -> Path | None:\n41\t    files = sorted(digests_dir.glob(\"candidates_*.csv\"))\n42\t    return files[-1] if files else None\n43\t\n44\t\n45\tdef _to_float(s: str) -> float | None:\n46\t    return float(s) if s not in (\"\", None) else None\n47\t\n48\t\n49\tdef load_candidates(path: str | Path) -> list[dict]:\n50\t    \"\"\"Load a candidates CSV into ranked dict rows (scores parsed; '' -> None).\"\"\"\n51\t    rows = []\n52\t    with Path(path).open(\"r\", encoding=\"utf-8\", newline=\"\") as f:\n53\t        for r in csv.DictReader(f):\n54\t            rows.append({\n55\t                \"rank\": int(r[\"rank\"]),\n56\t                \"arxiv_id\": r[\"arxiv_id\"],\n57\t                \"title\": r[\"title\"],\n58\t                \"link\": r[\"link\"],\n59\t                \"paper_date\": r.get(\"paper_date\", \"\"),\n60\t                \"stage1_score\": _to_float(r[\"stage1_score\"]),\n61\t                \"stage2_score\": _to_float(r[\"stage2_score\"]),\n62\t                \"abstract\": r.get(\"abstract\", \"\"),\n63\t            })\n64\t    rows.sort(key=lambda r: r[\"rank\"])\n65\t    return rows\n66\t\n67\t\n68\t# --------------------------------------------------------------------------- #\n69\t# Review session core (pending queue + decision recording)\n70\t# --------------------------------------------------------------------------- #\n71\t\n72\tclass ReviewSession:\n73\t    \"\"\"Holds the pending queue and records decisions to the feedback log.\"\"\"\n74\t\n75\t    def __init__(self, candidates: list[dict], *, run_date: str = \"\",\n76\t                 skip_reviewed: bool = True, feedback_path=feedback.FEEDBACK_PATH):\n77\t        self.run_date = run_date\n78\t        self.feedback_path = feedback_path\n79\t        already = feedback.reviewed_ids(feedback_path) if skip_reviewed else set()\n80\t        self.already_reviewed = len(already)\n81\t        self.queue = [c for c in candidates if c[\"arxiv_id\"] not in already]\n82\t        self.kept = 0\n83\t        self.skipped = 0\n84\t\n85\t    def record(self, cand: dict, decision: str, abstract_viewed: bool) -> dict:\n86\t        rec = feedback.record_event(\n87\t            arxiv_id=cand[\"arxiv_id\"], decision=decision, abstract_viewed=abstract_viewed,\n88\t            title=cand[\"title\"], link=cand[\"link\"], rank=cand.get(\"rank\"),\n89\t            stage1_score=cand.get(\"stage1_score\"), stage2_score=cand.get(\"stage2_score\"),\n90\t            run_date=self.run_date, path=self.feedback_path,\n91\t        )\n92\t        if decision == \"keep\":\n93\t            self.kept += 1\n94\t        else:\n95\t            self.skipped += 1\n96\t        return rec\n97\t\n98\t\n99\t# --------------------------------------------------------------------------- #\n100\t# Terminal frontend\n101\t# --------------------------------------------------------------------------- #\n102\t\n103\tdef _fmt_scores(c: dict) -> str:\n104\t    s1 = \"—\" if c[\"stage1_score\"] is None else f\"{c['stage1_score']:.3f}\"\n105\t    s2 = \"—\" if c[\"stage2_score\"] is None else f\"{c['stage2_score']:.3f}\"\n106\t    return f\"s1={s1} s2={s2}\"\n107\t\n108\t\n109\tdef _prompt(msg: str) -> str:\n110\t    try:\n111\t        return input(msg).strip().lower()\n112\t    except EOFError:\n113\t        return \"q\"\n114\t\n115\t\n116\tdef _batch_stats(batch_keeps: list[int]) -> dict:\n117\t    \"\"\"Trend stats for the between-batch prompt (pure -> unit-testable).\n118\t\n119\t    Because the queue is ranked best-first, keeps-per-batch should decay as you go\n120\t    deeper. ``tailing_off`` flags the inflection: the recent keep rate has dropped\n121\t    well below its peak, so you're likely into diminishing returns. Smoothed over\n122\t    the last two batches so one fluky batch doesn't trip (or suppress) it.\n123\t    \"\"\"\n124\t    this = batch_keeps[-1]\n125\t    prev = batch_keeps[-2] if len(batch_keeps) >= 2 else None\n126\t    peak = max(batch_keeps)\n127\t    pct_of_peak = round(100 * this / peak) if peak else 0\n128\t    recent = batch_keeps[-2:]\n129\t    recent_avg = sum(recent) / len(recent)\n130\t    # require a real peak (>=3) so tiny, noisy counts don't trigger a stop suggestion.\n131\t    tailing_off = len(batch_keeps) >= 2 and peak >= 3 and recent_avg <= 0.4 * peak\n132\t    return {\"this\": this, \"prev\": prev, \"peak\": peak,\n133\t            \"pct_of_peak\": pct_of_peak, \"tailing_off\": tailing_off}\n134\t\n135\t\n136\tdef _batch_report(batch_keeps: list[int], batch: int, kept: int, done: int) -> str:\n137\t    \"\"\"Format the between-batch trend line(s): this batch, trajectory, tail-off hint.\"\"\"\n138\t    st = _batch_stats(batch_keeps)\n139\t    rate = round(100 * st[\"this\"] / batch) if batch else 0\n140\t    orate = round(100 * kept / done) if done else 0\n141\t    if st[\"prev\"] is None:\n142\t        arrow = \"\"\n143\t    elif st[\"this\"] > st[\"prev\"]:\n144\t        arrow = f\"  ↑ from {st['prev']}\"\n145\t    elif st[\"this\"] < st[\"prev\"]:\n146\t        arrow = f\"  ↓ from {st['prev']}\"\n147\t    else:\n148\t        arrow = \"  → same as last\"\n149\t    traj = \" \".join(str(b) for b in batch_keeps)\n150\t    lines = [\n151\t        f\"\\n— batch {len(batch_keeps)}: kept {st['this']}/{batch} ({rate}%){arrow}\"\n152\t        f\"   ·   overall {kept}/{done} ({orate}%)\",\n153\t        f\"  keeps/batch: {traj}   (peak {st['peak']}, now {st['pct_of_peak']}% of peak)\",\n154\t    ]\n155\t    if st[\"tailing_off\"]:\n156\t        lines.append(\"  ▼ keep rate has fallen well below its peak — likely diminishing \"\n157\t                     \"returns; a natural place to stop.\")\n158\t    return \"\\n\".join(lines)\n159\t\n160\t\n161\tdef review_terminal(session: ReviewSession, *, batch: int) -> None:\n162\t    total = len(session.queue)\n163\t    if not total:\n164\t        print(\"Nothing to review — the queue is empty \"\n165\t              f\"({session.already_reviewed} already decided).\")\n166\t        return\n167\t    print(f\"\\n{total} papers to review ({session.already_reviewed} already decided). \"\n168\t          f\"Batches of {batch}. Keys: [k]eep [s]kip [a]bstract [o]pen [q]uit\\n\")\n169\t\n170\t    import textwrap\n171\t    import webbrowser\n172\t\n173\t    in_batch = 0\n174\t    prev_kept = 0\n175\t    batch_keeps: list[int] = []\n176\t    for c in session.queue:\n177\t        viewed = False\n178\t        print(f\"\\n[rank {c['rank']}]  {_fmt_scores(c)}  {c['paper_date']}\")\n179\t        print(textwrap.fill(c[\"title\"], width=88))\n180\t        print(f\"  {c['link']}\")\n181\t\n182\t        decision = None\n183\t        while decision is None:\n184\t            choice = _prompt(\"  [k]eep [s]kip [a]bstract [o]pen [q]uit > \")\n185\t            if choice in (\"k\", \"keep\"):\n186\t                decision = \"keep\"\n187\t            elif choice in (\"s\", \"skip\"):\n188\t                decision = \"skip\"\n189\t            elif choice in (\"a\", \"abstract\"):\n190\t                viewed = True\n191\t                print()\n192\t                print(textwrap.fill(c[\"abstract\"] or \"(no abstract)\", width=88,\n193\t                                    initial_indent=\"  \", subsequent_indent=\"  \"))\n194\t            elif choice in (\"o\", \"open\"):\n195\t                webbrowser.open(c[\"link\"])\n196\t                print(f\"  opened {c['link']}\")\n197\t            elif choice in (\"q\", \"quit\"):\n198\t                print(\"\\nquitting.\")\n199\t                _summary(session)\n200\t                return\n201\t            else:\n202\t                print(\"  (k/s/a/o/q)\")\n203\t\n204\t        session.record(c, decision, viewed)\n205\t        tag = \"KEPT\" if decision == \"keep\" else \"skip\"\n206\t        stage = \" [s1-neg]\" if (decision == \"skip\" and not viewed) else (\n207\t                \" [s1+, s2-]\" if (decision == \"skip\" and viewed) else\n208\t                \" [s1+, s2+]\" if viewed else \" [s1+]\")\n209\t        print(f\"  -> {tag}{stage}\")\n210\t\n211\t        in_batch += 1\n212\t        if in_batch >= batch:\n213\t            in_batch = 0\n214\t            batch_keeps.append(session.kept - prev_kept)\n215\t            prev_kept = session.kept\n216\t            done = session.kept + session.skipped\n217\t            print(_batch_report(batch_keeps, batch, session.kept, done))\n218\t            ans = _prompt(\"  keep going? [Y/n] \")\n219\t            if ans in (\"n\", \"no\", \"q\", \"quit\"):\n220\t                break\n221\t\n222\t    _summary(session)\n223\t\n224\t\n225\tdef _summary(session: ReviewSession) -> None:\n226\t    print(f\"\\n=== session done: {session.kept} kept, {session.skipped} skipped \"\n227\t          f\"({session.kept + session.skipped} total) ===\")\n228\t    print(f\"feedback log: {session.feedback_path}\")\n229\t\n230\t\n231\tdef main() -> None:\n232\t    ap = argparse.ArgumentParser(description=\"Terminal paper-review interface.\")\n233\t    ap.add_argument(\"--csv\", type=Path, default=None, help=\"candidates CSV (default: latest)\")\n234\t    ap.add_argument(\"--batch\", type=int, default=25, help=\"papers per batch before the density check\")\n235\t    ap.add_argument(\"--all\", action=\"store_true\", help=\"include already-decided papers\")\n236\t    args = ap.parse_args()\n237\t\n238\t    csv_path = args.csv or latest_candidates_csv()\n239\t    if not csv_path or not Path(csv_path).exists():\n240\t        print(\"No candidates CSV found — run `python -m recsys.infer` first.\")\n241\t        return\n242\t    run_date = Path(csv_path).stem.replace(\"candidates_\", \"\")\n243\t    print(f\"reviewing {csv_path}\")\n244\t    candidates = load_candidates(csv_path)\n245\t    session = ReviewSession(candidates, run_date=run_date, skip_reviewed=not args.all)\n246\t    review_terminal(session, batch=args.batch)\n247\t\n248\t\n249\tif __name__ == \"__main__\":\n250\t    main()\n251\t","tool_use_id":"toolu_01SV91DvcJhnAAeVvrwLMHtM","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/arxiv-summaries-workflow","dirty_fingerprint":"3f7c63b121e23d4c0015b606cbe53718565b5e5296f88904cbd24ec0d96de854","head":"4de35a5867b691d0820dce9f96716410195ab0a7","repo":"git@github.com:evintunador/arxiv-summari