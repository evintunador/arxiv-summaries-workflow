{"content":{"blocks":[{"content":"1\t\"\"\"Component 5 (download) — fetch PDFs for the papers I kept in review.\n2\t\n3\tReads the review feedback log (``state/feedback.jsonl``), takes the **latest**\n4\tdecision per arXiv ID (via :func:`recsys.feedback.kept_papers`), and downloads a\n5\tPDF for every *kept* paper into ``pdfs-to-summarize/`` — the folder the existing\n6\t``newsletter-podcast.py`` summarizer already consumes. This is deliberately a\n7\t**separate step you run after filtering**, not part of review, so triage stays\n8\tfast and offline and you only pull PDFs once you're done.\n9\t\n10\tIdempotent: a paper whose destination PDF already exists is skipped, so you can\n11\tre-run it as you work through a big backlog across sessions. Filenames mirror the\n12\tlegacy convention (``{title-with-illegal-chars-stripped}.pdf``) so the summarizer\n13\tand your Obsidian ``![[...]]`` embeds line up with the old ``pdfs/`` flow.\n14\t\n15\tUsage::\n16\t\n17\t    python -m recsys.review              # triage -> records keeps to state/feedback.jsonl\n18\t    python -m recsys.download            # fetch PDFs for everything kept (skip existing)\n19\t    python -m recsys.download --dry-run  # list what *would* download; fetch nothing\n20\t    python -m recsys.download --dest pdfs # download somewhere else\n21\t\"\"\"\n22\t\n23\tfrom __future__ import annotations\n24\t\n25\timport argparse\n26\timport re\n27\timport time\n28\tfrom pathlib import Path\n29\t\n30\timport requests\n31\t\n32\tfrom recsys import feedback\n33\t\n34\tREPO_ROOT = Path(__file__).resolve().parent.parent\n35\tDEST_DIR = REPO_ROOT / \"pdfs-to-summarize\"\n36\t\n37\t# arXiv asks for a descriptive UA; a bare requests default gets throttled harder.\n38\t_UA = \"arxiv-recsys/1.0 (mailto:evintunador@gmail.com)\"\n39\t\n40\t\n41\tdef safe_title(title: str) -> str:\n42\t    \"\"\"Filesystem-safe filename stem, matching the legacy downloader's scheme.\n43\t\n44\t    Mirrors ``arxiv-link-downloader.py`` (``[<>:\"/\\\\|?*]`` -> ``' -'``) so a paper\n45\t    kept here collides with (and is skipped against) one grabbed the old way.\n46\t    \"\"\"\n47\t    return re.sub(r'[<>:\"/\\\\|?*]', \" -\", title).strip()\n48\t\n49\t\n50\tdef pdf_url(arxiv_id: str) -> str:\n51\t    \"\"\"Canonical PDF URL for a (version-stripped) arXiv ID; serves the latest version.\"\"\"\n52\t    return f\"https://arxiv.org/pdf/{arxiv_id}.pdf\"\n53\t\n54\t\n55\tdef _download(url: str, dest: Path, *, timeout: float) -> None:\n56\t    \"\"\"Stream a PDF to ``dest`` atomically (write to ``.part``, then rename).\"\"\"\n57\t    resp = requests.get(url, headers={\"User-Agent\": _UA}, timeout=timeout, stream=True)\n58\t    resp.raise_for_status()\n59\t    ctype = resp.headers.get(\"Content-Type\", \"\")\n60\t    if \"pdf\" not in ctype.lower():\n61\t        raise RuntimeError(f\"not a PDF (Content-Type: {ctype or 'unknown'})\")\n62\t    tmp = dest.with_suffix(dest.suffix + \".part\")\n63\t    with tmp.open(\"wb\") as f:\n64\t        for chunk in resp.iter_content(chunk_size=1 << 15):\n65\t            if chunk:\n66\t                f.write(chunk)\n67\t    tmp.replace(dest)\n68\t\n69\t\n70\tdef run(*, dest_dir: Path = DEST_DIR, dry_run: bool = False, delay: float = 3.0,\n71\t        timeout: float = 30.0, limit: int | None = None,\n72\t        feedback_path=feedback.FEEDBACK_PATH) -> dict:\n73\t    \"\"\"Download PDFs for every kept paper missing from ``dest_dir``.\n74\t\n75\t    Returns a summary dict: ``{kept, already, downloaded, failed:[(id,err)]}``.\n76\t    \"\"\"\n77\t    kept = feedback.kept_papers(feedback_path)\n78\t    dest_dir.mkdir(parents=True, exist_ok=True)\n79\t\n80\t    pending = []\n81\t    already = 0\n82\t    for e in kept:\n83\t        stem = safe_title(e.get(\"title\") or e[\"arxiv_id\"])\n84\t        target = dest_dir / f\"{stem}.pdf\"\n85\t        if target.exists():\n86\t            already += 1\n87\t            continue\n88\t        pending.append((e, target))\n89\t    if limit is not None:\n90\t        pending = pending[:limit]\n91\t\n92\t    print(f\"kept: {len(kept)}  ·  already downloaded: {already}  ·  to fetch: {len(pending)}\"\n93\t          f\"{'  (dry run)' if dry_run else ''}\")\n94\t\n95\t    downloaded = 0\n96\t    failed: list[tuple[str, str]] = []\n97\t    for i, (e, target) in enumerate(pending, 1):\n98\t        aid = e[\"arxiv_id\"]\n99\t        url = pdf_url(aid)\n100\t        if dry_run:\n101\t            print(f\"  [{i}/{len(pending)}] would fetch {aid} -> {target.name}\")\n102\t            continue\n103\t        try:\n104\t            _download(url, target, timeout=timeout)\n105\t            downloaded += 1\n106\t            print(f\"  [{i}/{len(pending)}] {aid} -> {target.name}\")\n107\t        except Exception as ex:  # network/HTTP/non-PDF — log and keep going\n108\t            failed.append((aid, str(ex)))\n109\t            print(f\"  [{i}/{len(pending)}] FAILED {aid}: {ex}\")\n110\t        if i < len(pending):\n111\t            time.sleep(delay)  # be polite to arXiv\n112\t\n113\t    if failed:\n114\t        print(f\"\\n{len(failed)} failed:\")\n115\t        for aid, err in failed:\n116\t            print(f\"  {aid}: {err}\")\n117\t    if not dry_run:\n118\t        print(f\"\\ndone: {downloaded} downloaded into {dest_dir}\"\n119\t              f\"{f', {len(failed)} failed' if failed else ''}.\")\n120\t    return {\"kept\": len(kept), \"already\": already, \"downloaded\": downloaded, \"failed\": failed}\n121\t\n122\t\n123\tdef main() -> None:\n124\t    ap = argparse.ArgumentParser(description=\"Download PDFs for papers kept in review.\")\n125\t    ap.add_argument(\"--dest\", type=Path, default=DEST_DIR,\n126\t                    help=\"destination folder (default: pdfs-to-summarize/)\")\n127\t    ap.add_argument(\"--dry-run\", action=\"store_true\", help=\"list what would download; fetch nothing\")\n128\t    ap.add_argument(\"--delay\", type=float, default=3.0, help=\"politeness delay between downloads (s)\")\n129\t    ap.add_argument(\"--timeout\", type=float, default=30.0, help=\"per-request timeout (s)\")\n130\t    ap.add_argument(\"--limit\", type=int, default=None, help=\"cap the number of downloads this run\")\n131\t    args = ap.parse_args()\n132\t    run(dest_dir=args.dest, dry_run=args.dry_run, delay=args.delay,\n133\t        timeout=args.timeout, limit=args.limit)\n134\t\n135\t\n136\tif __name__ == \"__main__\":\n137\t    main()\n138\t","tool_use_id":"toolu_016z3LvYG6tj5s26rVQqQiS4","type":"tool_result"}],"role":"user"},"context":{"branch":"main","cwd":"/Users/evintunador/repos/evintunador/arxiv-summaries-workflow","dirty_fingerprint":"3f7c63b121e23d4c0015b606cbe53718565b5e5296f88904cbd24ec0d96de854","head":"4de35a5867b691d0820dce9f96716410195ab0a7","repo":"git@github.com:evintunador/arxiv-summaries-workflow.git"},"id":"ev2-df4a02cb07bc26c60bc3e9c69f9f60c87dd31ab623c4a4d8899b7c41cb69dcbb","kind":"conversation_turn","meta":{"actor":{"display":"Evin Tunador","id":"evintunador@gmail.com","type":"human"},"session_id":"eb608668-7a33-49bd-9512-90665e51d828","source":"claude-code","source_version":"2.1.228"},"occurred_at":"2026-08-12T01:37:52.169Z","producer":{"tool":"cledger","version":"0.20.0"},"raw":{"data":{"cwd":"/Users/evintunador/repos/evintunador/arxiv-summaries-workflow","entrypoint":"cli","gitBranch":"main","isSidechain":false,"message":{"content":[{"content":"1\t\"\"\"Component 5 (download) — fetch PDFs for the papers I kept in review.\n2\t\n3\tReads the review feedback log (``state/feedback.jsonl``), takes the **latest**\n4\tdecision per arXiv ID (via :func:`recsys.feedback.kept_papers`), and downloads a\n5\tPDF for every *kept* paper into ``pdfs-to-summarize/`` — the folder the existing\n6\t``newsletter-podcast.py`` summarizer already consumes. This is deliberately a\n7\t**separate step you run after filtering**, not part of review, so triage stays\n8\tfast and offline and you only pull PDFs once you're done.\n9\t\n10\tIdempotent: a paper whose destination PDF alrea